{
  "name": "@zpp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run src",
    "test:postgres": "vitest run --no-file-parallelism --maxWorkers=1 src/foundation-postgres.integration.test.ts src/foundation-stage2-postgres.integration.test.ts src/foundation-stage2-5-postgres.integration.test.ts src/foundation-stage3-postgres.integration.test.ts src/foundation-stage4-postgres.integration.test.ts src/foundation-stage5-postgres.integration.test.ts src/foundation-stage6-postgres.integration.test.ts src/foundation-stage7-postgres.integration.test.ts src/foundation-stage8-postgres.integration.test.ts src/foundation-stage9-postgres.integration.test.ts src/foundation-stage10-postgres.integration.test.ts src/foundation-stage11-postgres.integration.test.ts src/foundation-stage12-postgres.integration.test.ts src/foundation-stage13-postgres.integration.test.ts src/foundation-stage14-postgres.integration.test.ts src/foundation-stage15-postgres.integration.test.ts src/foundation-stage16-postgres.integration.test.ts src/foundation-stage17-postgres.integration.test.ts src/foundation-stage18-postgres.integration.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@zpp/shared": "file:../../packages/shared",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.5",
    "@types/swagger-ui-express": "^4.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
