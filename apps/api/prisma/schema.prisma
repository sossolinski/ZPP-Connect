generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                             @id @default(uuid()) @db.Uuid
  email                           String                             @unique
  displayName                     String
  department                      String?
  organizationId                  String?                            @db.Uuid
  status                          String                             @default("active")
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  organization                    Organization?                      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roles                           UserRole[]
  createdSessions                 Session[]                          @relation("SessionCreatedBy")
  closedSessions                  Session[]                          @relation("SessionClosedBy")
  approvedMatches                 MatchingRecord[]                   @relation("MatchApprovedBy")
  preparedReleaseActions          ReleaseAction[]                    @relation("ReleasePreparedBy")
  authorizedReleaseActions        ReleaseAction[]                    @relation("ReleaseAuthorizedBy")
  completedReleaseActions         ReleaseAction[]                    @relation("ReleaseCompletedBy")
  cancelledReleaseActions         ReleaseAction[]                    @relation("ReleaseCancelledBy")
  releaseChecks                   ReleaseCheck[]                     @relation("ReleaseCheckActor")
  assignedAssignments             AssignmentTask[]                   @relation("AssignmentAssignedTo")
  createdOperationalAssignments   AssignmentTask[]                   @relation("AssignmentCreatedBy")
  updatedOperationalAssignments   AssignmentTask[]                   @relation("AssignmentUpdatedBy")
  completedOperationalAssignments AssignmentTask[]                   @relation("AssignmentCompletedBy")
  cancelledOperationalAssignments AssignmentTask[]                   @relation("AssignmentCancelledBy")
  linkedMemberProfiles            MemberProfile[]                    @relation("MemberProfileLinkedUser")
  createdMemberProfiles           MemberProfile[]                    @relation("MemberProfileCreatedBy")
  updatedMemberProfiles           MemberProfile[]                    @relation("MemberProfileUpdatedBy")
  createdOperationalGroups        OperationalGroup[]                 @relation("OperationalGroupCreatedBy")
  updatedOperationalGroups        OperationalGroup[]                 @relation("OperationalGroupUpdatedBy")
  addedGroupMemberships           GroupMembership[]                  @relation("GroupMembershipAddedBy")
  removedGroupMemberships         GroupMembership[]                  @relation("GroupMembershipRemovedBy")
  groupRoleAssignments            GroupRoleAssignment[]
  createdRosterShifts             RosterShift[]                      @relation("RosterShiftCreatedBy")
  updatedRosterShifts             RosterShift[]                      @relation("RosterShiftUpdatedBy")
  publishedRosterShifts           RosterShift[]                      @relation("RosterShiftPublishedBy")
  confirmedRosterShifts           RosterShift[]                      @relation("RosterShiftConfirmedBy")
  declinedRosterShifts            RosterShift[]                      @relation("RosterShiftDeclinedBy")
  cancelledRosterShifts           RosterShift[]                      @relation("RosterShiftCancelledBy")
  completedRosterShifts           RosterShift[]                      @relation("RosterShiftCompletedBy")
  createdAvailabilities           Availability[]                     @relation("AvailabilityCreatedBy")
  updatedAvailabilities           Availability[]                     @relation("AvailabilityUpdatedBy")
  removedAvailabilities           Availability[]                     @relation("AvailabilityRemovedBy")
  incidentAssignments             IncidentAssignment[]               @relation("IncidentAssignedUser")
  createdIncidentAssignments      IncidentAssignment[]               @relation("IncidentAssignmentCreator")
  revokedIncidentAssignments      IncidentAssignment[]               @relation("IncidentAssignmentRevoker")
  passengerSrcConfirmations       PassengerRecord[]                  @relation("PassengerSrcConfirmedBy")
  passengerConditionUpdates       PassengerRecord[]                  @relation("PassengerConditionUpdatedBy")
  passengerHoldUpdates            PassengerRecord[]                  @relation("PassengerHoldUpdatedBy")
  familyClaimsCreated             RelationshipClaim[]                @relation("RelationshipClaimCreatedBy")
  familyVerificationDecisions     RelationshipVerificationDecision[] @relation("RelationshipDecisionBy")
  familyVerificationProjections   FamilyRecord[]                     @relation("FamilyVerificationProjectionBy")
  matchDecisions                  MatchDecision[]                    @relation("MatchDecisionBy")
  ownedRequests                   Request[]                          @relation("RequestOwner")
  createdRequests                 Request[]                          @relation("RequestCreatedBy")
  updatedRequests                 Request[]                          @relation("RequestUpdatedBy")
  resolvedRequests                Request[]                          @relation("RequestResolvedBy")
  reopenedRequests                Request[]                          @relation("RequestReopenedBy")
  cancelledRequests               Request[]                          @relation("RequestCancelledBy")
  verifiedTrainingRecords         MemberTrainingRecord[]             @relation("TrainingRecordVerifiedBy")
  auditLogs                       AuditLog[]                         @relation("ActorAudit")

  @@index([organizationId])
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  type         String?
  status       String   @default("active")
  contactEmail String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]

  @@index([status, name])
}

model Role {
  id               String                @id @default(uuid()) @db.Uuid
  name             String                @unique
  displayName      String
  description      String?
  permissions      Json
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            UserRole[]
  groupAssignments GroupRoleAssignment[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  scopeType  String   @default("GLOBAL")
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId, scopeType])
}

model Session {
  id                    String                             @id @default(uuid()) @db.Uuid
  operationalId         String                             @unique
  mode                  String
  status                String                             @default("Draft")
  eventType             String
  flightNumber          String?
  route                 String?
  aircraftRegistration  String?
  airportLocation       String?
  description           String?
  startAt               DateTime?
  endAt                 DateTime?
  createdById           String?                            @db.Uuid
  closedById            String?                            @db.Uuid
  notes                 String?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt
  createdBy             User?                              @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy              User?                              @relation("SessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  enquiries             Enquiry[]
  familyRecords         FamilyRecord[]
  relationshipClaims    RelationshipClaim[]
  relationshipDecisions RelationshipVerificationDecision[]
  matchSuggestions      MatchSuggestion[]
  matchDecisions        MatchDecision[]
  passengerRecords      PassengerRecord[]
  matchingRecords       MatchingRecord[]
  releaseActions        ReleaseAction[]
  releaseChecks         ReleaseCheck[]
  releaseOperations     ReleaseOperation[]
  requests              Request[]
  requestOperations     RequestOperation[]
  assignments           AssignmentTask[]
  assignmentOperations  AssignmentOperation[]
  timelineEvents        CaseTimelineEvent[]
  importBatches         ImportBatch[]
  files                 StoredFile[]
  exerciseInjects       ExerciseInject[]
  exerciseObservations  ExerciseObservation[]
  incidentAssignments   IncidentAssignment[]
  operationalGroups     OperationalGroup[]
  rosterShifts          RosterShift[]
  auditLogs             AuditLog[]

  @@index([mode, status])
}

model MemberProfile {
  id                     String            @id
  memberId               String            @unique
  linkedUserId           String?           @db.Uuid
  firstName              String
  lastName               String
  pool                   String
  role                   String
  assignedFunction       String
  contactEmail           String?
  normalizedContactEmail String?
  phone                  String?
  languages              String[]
  status                 String            @default("Active")
  version                Int               @default(1)
  legacyAvailability     String?
  legacyTrainingStatus   String?
  legacyRosterStatus     String?
  legacyAssignedLeader   String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  createdById            String?           @db.Uuid
  updatedById            String?           @db.Uuid
  linkedUser             User?             @relation("MemberProfileLinkedUser", fields: [linkedUserId], references: [id], onDelete: Restrict)
  createdBy              User?             @relation("MemberProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?             @relation("MemberProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships            GroupMembership[]
  rosterShifts           RosterShift[]
  availabilityRecords    Availability[]
  trainingRequirements   TrainingRequirement[]
  trainingRecords        MemberTrainingRecord[]

  @@index([status, pool, updatedAt])
  @@index([assignedFunction, status])
  @@index([linkedUserId])
}

model OperationalGroup {
  id              String                @id
  operationalId   String                @unique
  incidentId      String                @db.Uuid
  name            String
  pool            String
  functionName    String
  status          String                @default("Active")
  notes           String?
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdById     String?               @db.Uuid
  updatedById     String?               @db.Uuid
  incident        Session               @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  createdBy       User?                 @relation("OperationalGroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("OperationalGroupUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships     GroupMembership[]
  roleAssignments GroupRoleAssignment[]
  rosterShifts    RosterShift[]
  trainingRequirements TrainingRequirement[]

  @@unique([id, incidentId])
  @@index([incidentId, status, updatedAt])
  @@index([incidentId, pool, functionName])
}

model GroupMembership {
  id              String           @id
  groupId         String
  memberProfileId String
  role            String           @default("Member")
  addedAt         DateTime         @default(now())
  addedById       String?          @db.Uuid
  updatedAt       DateTime         @updatedAt
  removedAt       DateTime?
  removedById     String?          @db.Uuid
  group           OperationalGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  memberProfile   MemberProfile    @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)
  addedBy         User?            @relation("GroupMembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  removedBy       User?            @relation("GroupMembershipRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([groupId, removedAt, role])
  @@index([memberProfileId, removedAt])
}

model GroupRoleAssignment {
  id         String           @id
  userId     String           @db.Uuid
  roleId     String           @db.Uuid
  groupId    String
  status     String           @default("Active")
  assignedAt DateTime         @default(now())
  assignedBy String?          @db.Uuid
  revokedAt  DateTime?
  revokedBy  String?          @db.Uuid
  version    Int              @default(1)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  group      OperationalGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([groupId, status])
}

model TrainingCourse {
  id               String                 @id
  code             String
  normalizedCode   String                 @unique
  title            String
  description      String?
  category         String
  deliveryType     String
  validityMonths   Int?
  active           Boolean                @default(true)
  selfCompletable  Boolean                @default(false)
  externalRef      String?
  version          Int                    @default(1)
  deactivatedAt    DateTime?
  reactivatedAt    DateTime?
  legacyImported   Boolean                @default(false)
  legacyMetadata   Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String?                @db.Uuid
  updatedById      String?                @db.Uuid
  requirements     TrainingRequirement[]
  records          MemberTrainingRecord[]

  @@index([active, category, title])
  @@index([updatedAt])
}

model TrainingRequirement {
  id               String                 @id
  courseId         String
  targetType       String
  targetRole       String?
  groupId          String?
  memberProfileId  String?
  requiredStatus   String
  dueAt            DateTime?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  active           Boolean                @default(true)
  version          Int                    @default(1)
  provenance       Json?
  endedAt          DateTime?
  endedById        String?                @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String?                @db.Uuid
  updatedById      String?                @db.Uuid
  course           TrainingCourse         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group            OperationalGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  memberProfile    MemberProfile?         @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)
  records          MemberTrainingRecord[]

  @@unique([id, courseId])
  @@index([courseId, active, effectiveFrom, effectiveTo])
  @@index([targetType, targetRole, active])
  @@index([groupId, active])
  @@index([memberProfileId, active])
}

model MemberTrainingRecord {
  id                    String                @id
  operationalId         String                @unique
  memberProfileId       String
  courseId              String
  sourceRequirementId   String?
  assignedAt            DateTime
  assignedById          String?               @db.Uuid
  dueAt                  DateTime?
  status                 String                @default("Assigned")
  startedAt              DateTime?
  startedById            String?               @db.Uuid
  completedAt            DateTime?
  completedById          String?               @db.Uuid
  expiryAt               DateTime?
  score                  Int?
  completionNote         String?
  completionRef          String?
  verifiedById           String?               @db.Uuid
  verifiedAt             DateTime?
  waivedAt               DateTime?
  waivedById             String?               @db.Uuid
  waiverReason           String?
  cancelledAt            DateTime?
  cancelledById          String?               @db.Uuid
  cancelledReason        String?
  version                Int                   @default(1)
  provenance             Json?
  legacyImported         Boolean               @default(false)
  legacyMetadata         Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  createdById            String?               @db.Uuid
  updatedById            String?               @db.Uuid
  memberProfile          MemberProfile         @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)
  course                 TrainingCourse        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sourceRequirement      TrainingRequirement?  @relation(fields: [sourceRequirementId, courseId], references: [id, courseId], onDelete: Restrict)
  verifiedBy             User?                 @relation("TrainingRecordVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  operations             TrainingOperation[]

  @@index([memberProfileId, courseId, status])
  @@index([courseId, status, dueAt])
  @@index([sourceRequirementId])
  @@index([expiryAt])
}

model TrainingOperation {
  id                 String                @id @default(uuid()) @db.Uuid
  operationId        String                @unique @db.Uuid
  memberTrainingId   String?
  command            String
  commandFingerprint String
  resultVersion      Int
  result             Json
  requestId          String?
  createdAt          DateTime              @default(now())
  memberTraining     MemberTrainingRecord? @relation(fields: [memberTrainingId], references: [id], onDelete: Cascade)

  @@index([memberTrainingId, createdAt])
}

model RosterShift {
  id                      String               @id
  operationalId           String               @unique
  sessionId               String               @db.Uuid
  groupId                 String?
  assignedMemberProfileId String?
  title                   String
  duty                    String
  functionName            String
  startAt                 DateTime
  endAt                   DateTime
  location                String
  status                  String               @default("Draft")
  notes                   String?
  version                 Int                  @default(1)
  publishedAt             DateTime?
  publishedById           String?              @db.Uuid
  confirmedAt             DateTime?
  confirmedById           String?              @db.Uuid
  declinedAt              DateTime?
  declinedById            String?              @db.Uuid
  cancelledAt             DateTime?
  cancelledById           String?              @db.Uuid
  cancelReason            String?
  completedAt             DateTime?
  completedById           String?              @db.Uuid
  legacyImported          Boolean              @default(false)
  legacyMetadata          Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  createdById             String?              @db.Uuid
  updatedById             String?              @db.Uuid
  session                 Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  group                   OperationalGroup?    @relation(fields: [groupId, sessionId], references: [id, incidentId], onDelete: Restrict)
  assignedMemberProfile   MemberProfile?       @relation(fields: [assignedMemberProfileId], references: [id], onDelete: Restrict)
  createdBy               User?                @relation("RosterShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                @relation("RosterShiftUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedBy             User?                @relation("RosterShiftPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  confirmedBy             User?                @relation("RosterShiftConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  declinedBy              User?                @relation("RosterShiftDeclinedBy", fields: [declinedById], references: [id], onDelete: SetNull)
  cancelledBy             User?                @relation("RosterShiftCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  completedBy             User?                @relation("RosterShiftCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  operations              RosteringOperation[]

  @@index([sessionId, status, startAt])
  @@index([sessionId, assignedMemberProfileId, startAt])
  @@index([sessionId, groupId, startAt])
  @@index([sessionId, functionName, startAt])
}

model Availability {
  id              String               @id
  operationalId   String               @unique
  memberProfileId String
  startAt         DateTime
  endAt           DateTime
  type            String
  note            String?
  status          String               @default("Active")
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdById     String?              @db.Uuid
  updatedById     String?              @db.Uuid
  removedAt       DateTime?
  removedById     String?              @db.Uuid
  memberProfile   MemberProfile        @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation("AvailabilityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                @relation("AvailabilityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  removedBy       User?                @relation("AvailabilityRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  operations      RosteringOperation[]

  @@index([memberProfileId, status, startAt])
  @@index([type, status, startAt])
}

model RosteringOperation {
  id                 String        @id @default(uuid()) @db.Uuid
  operationId        String        @unique @db.Uuid
  rosterShiftId      String?
  availabilityId     String?
  command            String
  commandFingerprint String
  resultVersion      Int
  requestId          String?
  createdAt          DateTime      @default(now())
  rosterShift        RosterShift?  @relation(fields: [rosterShiftId], references: [id], onDelete: Cascade)
  availability       Availability? @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([rosterShiftId, createdAt])
  @@index([availabilityId, createdAt])
}

model Enquiry {
  id                  String           @id @default(uuid()) @db.Uuid
  operationalId       String           @unique
  sessionId           String           @db.Uuid
  caseId              String?
  contactChannel      String
  callerName          String
  callerPhone         String?
  callerEmail         String?
  callerLocation      String?
  preferredLanguage   String?
  claimedRelationship String?
  passengerRecordId   String?          @db.Uuid
  passengerFirstName  String?
  passengerLastName   String?
  passengerFlight     String?
  passengerRoute      String?
  lastKnownContact    String?
  enquiryType         String
  urgency             String           @default("Normal")
  notes               String?
  status              String           @default("New")
  version             Int              @default(1)
  createdById         String?          @db.Uuid
  updatedById         String?          @db.Uuid
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  session             Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  passengerRecord     PassengerRecord? @relation(fields: [passengerRecordId], references: [id], onDelete: SetNull)
  matches             MatchingRecord[]
  requests            Request[]

  @@index([sessionId, status, updatedAt])
  @@index([caseId])
  @@index([passengerRecordId])
}

model IncidentAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  incidentId   String    @db.Uuid
  userId       String    @db.Uuid
  function     String?
  scope        String    @default("OPERATIONAL")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  createdById  String?   @db.Uuid
  revokedAt    DateTime?
  revokedById  String?   @db.Uuid
  revokeReason String?
  updatedAt    DateTime  @updatedAt
  incident     Session   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user         User      @relation("IncidentAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation("IncidentAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy    User?     @relation("IncidentAssignmentRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([incidentId, userId])
  @@index([userId, active])
  @@index([incidentId, active])
}

model FamilyRecord {
  id                       String              @id @default(uuid()) @db.Uuid
  operationalId            String              @unique
  sessionId                String              @db.Uuid
  caseId                   String?
  sourceBatchId            String?             @db.Uuid
  sourceImportedAt         DateTime?
  firstName                String
  lastName                 String
  phone                    String?
  email                    String?
  normalizedPhone          String?
  normalizedEmail          String?
  preferredContactChannel  String?
  preferredLanguage        String?
  location                 String?
  claimedRelationship      String?
  passengerFirstName       String?
  passengerLastName        String?
  passengerFlight          String?
  verificationStatus       String              @default("Unverified")
  verificationNotes        String?
  verificationDecisionById String?             @db.Uuid
  verificationDecisionAt   DateTime?
  verifiedRelationship     String?
  immediateNeeds           String?
  questionsAsked           String?
  commitmentsMade          String?
  nextContactDue           DateTime?
  assignedOfficer          String?
  notes                    String?
  version                  Int                 @default(1)
  createdById              String?             @db.Uuid
  updatedById              String?             @db.Uuid
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  session                  Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceBatch              ImportBatch?        @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  verificationDecisionBy   User?               @relation("FamilyVerificationProjectionBy", fields: [verificationDecisionById], references: [id], onDelete: SetNull)
  relationshipClaims       RelationshipClaim[]
  matches                  MatchingRecord[]
  requests                 Request[]

  @@index([sessionId, verificationStatus, updatedAt])
  @@index([sessionId, normalizedPhone])
  @@index([sessionId, normalizedEmail])
  @@index([sessionId, sourceBatchId])
  @@index([caseId])
}

model RelationshipClaim {
  id                        String                             @id @default(uuid()) @db.Uuid
  incidentId                String                             @db.Uuid
  familyRecordId            String                             @db.Uuid
  passengerRecordId         String?                            @db.Uuid
  claimedRelationshipType   String?
  claimedPassengerFirstName String?
  claimedPassengerLastName  String?
  claimedPassengerFlight    String?
  source                    String                             @default("OPERATOR")
  status                    String                             @default("PENDING")
  isCurrent                 Boolean                            @default(true)
  version                   Int                                @default(1)
  claimedById               String?                            @db.Uuid
  claimedAt                 DateTime                           @default(now())
  supersededAt              DateTime?
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  incident                  Session                            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  familyRecord              FamilyRecord                       @relation(fields: [familyRecordId], references: [id], onDelete: Cascade)
  passengerRecord           PassengerRecord?                   @relation(fields: [passengerRecordId], references: [id], onDelete: SetNull)
  claimedBy                 User?                              @relation("RelationshipClaimCreatedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  decisions                 RelationshipVerificationDecision[]
  matchSuggestions          MatchSuggestion[]
  matchDecisions            MatchDecision[]
  matchingRecords           MatchingRecord[]
  releaseActions            ReleaseAction[]

  @@index([incidentId, status, updatedAt])
  @@index([incidentId, familyRecordId])
  @@index([incidentId, passengerRecordId])
}

model RelationshipVerificationDecision {
  id                       String            @id @default(uuid()) @db.Uuid
  incidentId               String            @db.Uuid
  relationshipClaimId      String            @db.Uuid
  result                   String
  basis                    String
  verifiedRelationshipType String?
  previousStatus           String
  nextStatus               String
  claimVersionBefore       Int
  claimVersionAfter        Int
  decisionById             String?           @db.Uuid
  decisionAt               DateTime          @default(now())
  requestId                String?
  createdAt                DateTime          @default(now())
  incident                 Session           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  relationshipClaim        RelationshipClaim @relation(fields: [relationshipClaimId], references: [id], onDelete: Cascade)
  decisionBy               User?             @relation("RelationshipDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)

  @@index([incidentId, relationshipClaimId, decisionAt])
  @@index([incidentId, result, decisionAt])
}

model PassengerRecord {
  id                       String              @id @default(uuid()) @db.Uuid
  operationalId            String              @unique
  sessionId                String              @db.Uuid
  caseId                   String?
  personType               String
  firstName                String
  lastName                 String
  dateOfBirth              DateTime?
  age                      Int?
  gender                   String?
  nationality              String?
  flightNumber             String?
  route                    String?
  seat                     String?
  pnr                      String?
  ticketNumber             String?
  manifestVersion          String?
  source                   String
  sourceBatchId            String?             @db.Uuid
  sourceExternalId         String?
  sourceImportedAt         DateTime?
  travellingCompanions     String?
  conditionStatus          String              @default("Unknown")
  conditionUpdatedAt       DateTime?
  conditionUpdatedById     String?             @db.Uuid
  conditionBasis           String?
  holdStatus               String              @default("No hold")
  holdUpdatedAt            DateTime?
  holdUpdatedById          String?             @db.Uuid
  holdReason               String?
  srcConfirmed             Boolean             @default(false)
  srcConfirmedAt           DateTime?
  srcConfirmedById         String?             @db.Uuid
  srcConfirmationBasis     String?
  notes                    String?
  version                  Int                 @default(1)
  createdById              String?             @db.Uuid
  updatedById              String?             @db.Uuid
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  session                  Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceBatch              ImportBatch?        @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  srcConfirmedBy           User?               @relation("PassengerSrcConfirmedBy", fields: [srcConfirmedById], references: [id], onDelete: SetNull)
  conditionUpdatedBy       User?               @relation("PassengerConditionUpdatedBy", fields: [conditionUpdatedById], references: [id], onDelete: SetNull)
