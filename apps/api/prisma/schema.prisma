model MatchingRecord {
  id                    String             @id @default(uuid()) @db.Uuid
  operationalId         String             @unique
  sessionId             String             @db.Uuid
  caseId                String?
  enquiryId             String?            @db.Uuid
  familyRecordId        String?            @db.Uuid
  passengerRecordId     String?            @db.Uuid
  relationshipClaimId   String?            @db.Uuid
  suggestionId          String?            @db.Uuid
  status                String             @default("Potential match")
  matchScore            Float?
  matchBasis            String?
  verificationChecklist Json?
  holdCheck             String             @default("No hold")
  decisionNotes         String?
  coordinatorOverride   Boolean            @default(false)
  overrideReason        String?
  approvedById          String?            @db.Uuid
  approvedAt            DateTime?
  version               Int                @default(1)
  createdById           String?            @db.Uuid
  updatedById           String?            @db.Uuid
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  session               Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enquiry               Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  familyRecord          FamilyRecord?      @relation(fields: [familyRecordId], references: [id], onDelete: SetNull)
  passengerRecord       PassengerRecord?   @relation(fields: [passengerRecordId], references: [id], onDelete: SetNull)
  relationshipClaim     RelationshipClaim? @relation(fields: [relationshipClaimId], references: [id], onDelete: SetNull)
  suggestion            MatchSuggestion?   @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  approvedBy            User?              @relation("MatchApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  decisions             MatchDecision[]
  releaseActions        ReleaseAction[]

  @@index([sessionId, status])
  @@index([sessionId, relationshipClaimId])
  @@index([sessionId, passengerRecordId])
  @@index([caseId])
}

model MatchSuggestion {
  id                  String            @id @default(uuid()) @db.Uuid
  incidentId          String            @db.Uuid
  relationshipClaimId String            @db.Uuid
  passengerRecordId   String            @db.Uuid
  score               Float
  positiveSignals     Json
  conflicts           Json
  algorithm           String
  algorithmVersion    String
  generationId        String            @db.Uuid
  claimVersion        Int
  passengerVersion    Int
  status              String            @default("ACTIVE")
  isCurrent           Boolean           @default(true)
  version             Int               @default(1)
  generatedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  incident            Session           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  relationshipClaim   RelationshipClaim @relation(fields: [relationshipClaimId], references: [id], onDelete: Cascade)
  passengerRecord     PassengerRecord   @relation(fields: [passengerRecordId], references: [id], onDelete: Cascade)
  matchingRecords     MatchingRecord[]
  decisions           MatchDecision[]

  @@index([incidentId, relationshipClaimId, isCurrent, score])
  @@index([incidentId, passengerRecordId, isCurrent])
  @@index([generationId])
}

model MatchDecision {
  id                   String            @id @default(uuid()) @db.Uuid
  incidentId           String            @db.Uuid
  relationshipClaimId  String            @db.Uuid
  passengerRecordId    String            @db.Uuid
  matchingRecordId     String?           @db.Uuid
  suggestionId         String?           @db.Uuid
  decision             String
  reason               String
  validity             String            @default("CURRENT")
  isCurrent            Boolean           @default(false)
  claimVersion         Int
  passengerVersion     Int
  operationId          String            @db.Uuid
  commandFingerprint   String
  decisionById         String?           @db.Uuid
  decidedAt            DateTime          @default(now())
  requestId            String?
  supersedesDecisionId String?           @db.Uuid
  createdAt            DateTime          @default(now())
  incident             Session           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  relationshipClaim    RelationshipClaim @relation(fields: [relationshipClaimId], references: [id], onDelete: Cascade)
  passengerRecord      PassengerRecord   @relation(fields: [passengerRecordId], references: [id], onDelete: Cascade)
  matchingRecord       MatchingRecord?   @relation(fields: [matchingRecordId], references: [id], onDelete: SetNull)
  suggestion           MatchSuggestion?  @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  decisionBy           User?             @relation("MatchDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)
  supersedesDecision   MatchDecision?    @relation("MatchDecisionSupersession", fields: [supersedesDecisionId], references: [id], onDelete: SetNull)
  supersededBy         MatchDecision[]   @relation("MatchDecisionSupersession")
  releaseActions       ReleaseAction[]

  @@unique([incidentId, operationId])
  @@index([incidentId, relationshipClaimId, decidedAt])
  @@index([incidentId, passengerRecordId, decidedAt])
  @@index([matchingRecordId])
  @@index([suggestionId])
}

model ReleaseAction {
  id                              String             @id @default(uuid()) @db.Uuid
  operationalId                   String             @unique
  incidentId                      String             @db.Uuid
  actionType                      String             @default("REUNIFICATION")
  status                          String             @default("PREPARED")
  relationshipClaimId             String?            @db.Uuid
  matchDecisionId                 String?            @db.Uuid
  matchingRecordId                String?            @db.Uuid
  passengerRecordId               String?            @db.Uuid
  relationshipClaimVersion        Int?
  passengerVersion                Int?
  releaseDestination              String?
  receivingParty                  String?
  transportMode                   String?
  notes                           String?
  version                         Int                @default(1)
  preparedById                    String?            @db.Uuid
  preparedAt                      DateTime           @default(now())
  authorizedById                  String?            @db.Uuid
  authorizedAt                    DateTime?
  authorizationReason             String?
  authorizedClaimVersion          Int?
  authorizedPassengerVersion      Int?
  completedById                   String?            @db.Uuid
  completedAt                     DateTime?
  completionNotes                 String?
  cancelledById                   String?            @db.Uuid
  cancelledAt                     DateTime?
  cancelReason                    String?
  legacyImported                  Boolean            @default(false)
  verificationEvidenceUnavailable Boolean            @default(false)
  legacyMetadata                  Json?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  incident                        Session            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  relationshipClaim               RelationshipClaim? @relation(fields: [relationshipClaimId], references: [id], onDelete: Restrict)
  matchDecision                   MatchDecision?     @relation(fields: [matchDecisionId], references: [id], onDelete: Restrict)
  matchingRecord                  MatchingRecord?    @relation(fields: [matchingRecordId], references: [id], onDelete: SetNull)
  passengerRecord                 PassengerRecord?   @relation(fields: [passengerRecordId], references: [id], onDelete: Restrict)
  preparedBy                      User?              @relation("ReleasePreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  authorizedBy                    User?              @relation("ReleaseAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  completedBy                     User?              @relation("ReleaseCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledBy                     User?              @relation("ReleaseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  checks                          ReleaseCheck[]
  operations                      ReleaseOperation[]
  requests                        Request[]

  @@index([incidentId, status, updatedAt])
  @@index([incidentId, actionType, updatedAt])
  @@index([relationshipClaimId])
  @@index([matchDecisionId])
  @@index([passengerRecordId])
}

model ReleaseCheck {
  id                  String         @id @default(uuid()) @db.Uuid
