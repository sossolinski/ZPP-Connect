model Request {
  id                       String             @id @default(uuid()) @db.Uuid
  operationalId            String
  incidentId               String             @map("sessionId") @db.Uuid
  caseId                   String?
  relatedEnquiryId         String?            @db.Uuid
  relatedFamilyRecordId    String?            @db.Uuid
  relatedPassengerRecordId String?            @db.Uuid
  relatedReleaseActionId   String?            @db.Uuid
  category                 String
  priority                 String             @default("Normal")
  requester                String?
  ownerUserId              String?            @db.Uuid
  legacyOwnerLabel         String?            @map("ownerAssignedTo")
  details                  String
  approvalStatus           String             @default("Not required")
  status                   String             @default("OPEN")
  dueAt                    DateTime?
  resolutionOutcome        String?
  resolutionNote           String?            @map("closureNote")
  resolvedById             String?            @db.Uuid
  resolvedAt               DateTime?
  reopenedById             String?            @db.Uuid
  reopenedAt               DateTime?
  reopenReason             String?
  cancelledById            String?            @db.Uuid
  cancelledAt              DateTime?
  cancelReason             String?
  notes                    String?
  version                  Int                @default(1)
  legacyImported           Boolean            @default(false)
  legacyMetadata           Json?
  createdById              String?            @db.Uuid
  updatedById              String?            @db.Uuid
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  incident                 Session            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  relatedEnquiry           Enquiry?           @relation(fields: [relatedEnquiryId], references: [id], onDelete: SetNull)
  relatedFamilyRecord      FamilyRecord?      @relation(fields: [relatedFamilyRecordId], references: [id], onDelete: SetNull)
  relatedPassengerRecord   PassengerRecord?   @relation(fields: [relatedPassengerRecordId], references: [id], onDelete: SetNull)
  relatedReleaseAction     ReleaseAction?     @relation(fields: [relatedReleaseActionId], references: [id], onDelete: SetNull)
  owner                    User?              @relation("RequestOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy                User?              @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?              @relation("RequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  resolvedBy               User?              @relation("RequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  reopenedBy               User?              @relation("RequestReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  cancelledBy              User?              @relation("RequestCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  operations               RequestOperation[]

  @@unique([incidentId, operationalId])
  @@index([incidentId, status, updatedAt(sort: Desc)])
  @@index([incidentId, priority, status])
  @@index([incidentId, ownerUserId, status])
  @@index([incidentId, dueAt])
  @@index([caseId])
  @@map("WelfareRequest")
}

